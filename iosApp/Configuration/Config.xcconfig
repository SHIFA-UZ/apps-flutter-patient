TEAM_ID=NH97PGA9PT

PRODUCT_NAME=Shifa
PRODUCT_BUNDLE_IDENTIFIER=uz.shifa.patient

CURRENT_PROJECT_VERSION=1
// The version for iOS and Android (composeApp/build.gradle.kts reads it). Bump it here only.
MARKETING_VERSION=1.2.5

// The PostHog project key (docs/posthog/setup.md §2): release builds only; Debug builds never track (README D4).
// Empty means analytics off. Secrets.xcconfig (gitignored; CI writes the key there) provides it.
POSTHOG_API_KEY_PROD=
#include? "Secrets.xcconfig"
POSTHOG_API_KEY[config=Debug]=
POSTHOG_API_KEY[config=Release]=$(POSTHOG_API_KEY_PROD)
