{"nodes": [{"id": "docs_kmp_spec_05_auth", "label": "05 Authentication & Account Lifecycle spec", "file_type": "document", "source_file": "docs/kmp-spec/05-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kmp_spec_05_auth_authrepository", "label": "AuthRepository", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a70, \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kmp_spec_05_auth_authnotifier", "label": "AuthNotifier", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.2, \u00a75.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kmp_spec_05_auth_authstate", "label": "AuthState", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a75.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "copyWith always overwrites error (omitted means null); forcePasswordReset lives only in memory (Q4)."}, {"id": "docs_kmp_spec_05_auth_loginattemptservice", "label": "LoginAttemptService (login lockout)", "file_type": "rationale", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5 failures -> 5 min lockout; client-only and device-wide, counts network errors too (Q11)."}, {"id": "docs_kmp_spec_05_auth_passwordvalidation", "label": "PasswordValidation (password policy)", "file_type": "rationale", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a76.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8..128 chars, upper/lower/digit/special; mirrors backend PasswordPolicy. Not used by Change Password (Q9)."}, {"id": "docs_kmp_spec_05_auth_autherrorsanitizer", "label": "AuthErrorSanitizer", "file_type": "rationale", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a76.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only known-safe backend messages are passed through; unknown messages are never shown, status-code defaults otherwise."}, {"id": "docs_kmp_spec_05_auth_error_localizations", "label": "userFriendlyError / translateError (error_localizations)", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a76.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps canonical English backend strings to l10n keys; KMP should reuse the mapping verbatim."}, {"id": "docs_kmp_spec_05_auth_storageservice", "label": "StorageService (secure token storage)", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a76.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT in Keystore/Keychain; resetOnError wipes undecryptable entries instead of throwing forever. No refresh token."}, {"id": "docs_kmp_spec_05_auth_first_launch_keychain_clear", "label": "First-launch keychain clear (has_launched_before)", "file_type": "rationale", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iOS Keychain survives uninstall, so a stale token is cleared on first launch."}, {"id": "docs_kmp_spec_05_auth_apiclient_401_handling", "label": "Global 401 handling (ApiClient)", "file_type": "rationale", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 401 logs out; skips /auth/ and /public/, requests without auth header, 5 s rate limit, 10 s grace after token save."}, {"id": "docs_kmp_spec_05_auth_public_auth_paths", "label": "Unauthenticated auth path list (isUnauthenticatedAuthPath)", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kmp_spec_05_auth_router_guard", "label": "Router auth guard (redirect table)", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redirect re-runs only when isAuthenticated flips (Q5); KMP should observe forcePasswordReset too."}, {"id": "docs_kmp_spec_05_auth_splash_session_restore", "label": "Splash & session restore", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any non-401 validation failure is treated as valid so users stay signed in offline (Q18)."}, {"id": "docs_kmp_spec_05_auth_login_flow", "label": "Login flow (identifier + password)", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kmp_spec_05_auth_normalizephoneforsms", "label": "normalizePhoneForSms", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.2, Q8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weak: no country code prepended, keeps spaces/dashes after '+'."}, {"id": "docs_kmp_spec_05_auth_registration_otp_flow", "label": "Registration with OTP", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kmp_spec_05_auth_sms_email_otp_fallback", "label": "SMS-to-email OTP fallback", "file_type": "rationale", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Falls back to email after 3 SMS sends, on 503 SMS unavailable, 429 rate limit, or server-side channel=email."}, {"id": "docs_kmp_spec_05_auth_otp_exceptions", "label": "OTP exceptions (SmsOtpUnavailableException, OtpRateLimitException)", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kmp_spec_05_auth_doctor_to_patient_conversion", "label": "Existing doctor to patient conversion", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Email is required; phone-only doctor matches dead-end (Q7)."}, {"id": "docs_kmp_spec_05_auth_forgot_password_flow", "label": "Forgot password flow", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OTP screen never verifies the code server-side; invalid code only errors on the next screen (Q12)."}, {"id": "docs_kmp_spec_05_auth_forced_password_reset", "label": "Forced password reset", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kmp_spec_05_auth_change_password", "label": "Change password", "file_type": "concept", "source_file": "docs/kmp-spec/05-auth.md", "source_location": "\u00a72.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only checks >= 6 chars instead of full policy (Q9)."}, {"id": "docs_kmp_spec_05_auth_logout", "label": "Logout", "file_typ